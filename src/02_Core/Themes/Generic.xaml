<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ForestM8rix"
    xmlns:rendering="clr-namespace:ForestM8rix.Rendering">

    <Style TargetType="{x:Type local:ForestM8rixView}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ForestM8rixView}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="LightGray"
                                BorderThickness="0,0,0,1" 
                                BorderBrush="DarkGray">
                            <rendering:ForestM8rixHeader x:Name="PART_Header" 
                Height="{TemplateBinding HeaderHeight}"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                Scale="{Binding Manager.Scale, RelativeSource={RelativeSource TemplatedParent}}"
                Columns="{Binding Manager.Columns, RelativeSource={RelativeSource TemplatedParent}}"
                HorizontalOffset="{Binding HorizontalOffset, ElementName=PART_ScrollViewer}"/>

                            <!--<Border BorderBrush="DarkGray" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>-->
                        </Border>

                        <ScrollViewer x:Name="PART_ScrollViewer" 
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                      Grid.Row="1"              
                                      >
                            <Canvas x:Name="PART_Canvas" 
                    
                VerticalAlignment="Top"
                                    HorizontalAlignment="Left"
                                    />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>