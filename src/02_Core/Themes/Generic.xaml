<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ForestM8rix"
    xmlns:rendering="clr-namespace:ForestM8rix.Rendering">
    <Style TargetType="{x:Type local:ForestM8rixView}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ForestM8rixView}">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <rendering:ForestM8rixHeader Grid.Row="0" Height="35" />

                        <ScrollViewer x:Name="PART_ScrollViewer" 
                      Grid.Row="1"
                      Background="{x:Null}">
                            <Canvas x:Name="PART_Canvas" Background="Transparent" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
