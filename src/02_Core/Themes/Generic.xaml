<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ForestM8rix"
    xmlns:rendering="clr-namespace:ForestM8rix.Rendering">

    <Style TargetType="{x:Type local:ForestM8rixView}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ForestM8rixView}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <rendering:ForestM8rixHeader x:Name="PART_Header" 
                                Grid.Row= "0"
                                Height="{TemplateBinding HeaderHeight}"
                                Background="LightGray"/>

                            <ScrollViewer x:Name="PART_ScrollViewer" 
                                          Grid.Row="1"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">

                                <Canvas x:Name="PART_Canvas" Background="White"/>

                            </ScrollViewer>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>